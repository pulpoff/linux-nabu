# VibeOS fragment for the Xiaomi Pad 5 on Kumar-Jy's nabu/7.3.y (merged over nabu_defconfig + olddefconfig)
# --- kernel naming and boot image (header v0 wants Image.gz; no DWARF to keep the build small)
CONFIG_LOCALVERSION="-nabu"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_EFI_ZBOOT is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF5 is not set

# --- other platforms off
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_XEN is not set
# CONFIG_DRM_PANTHOR is not set
# CONFIG_DRM_POWERVR is not set
# CONFIG_DRM_KOMEDA is not set
# CONFIG_DRM_TIDSS is not set
# CONFIG_MISC_RP1 is not set
# CONFIG_PCI_MESON is not set
# CONFIG_GREYBUS is not set

# --- nabu: touch SPI bus and PMIC RTC built in (Kumar-Jy's config has spi-geni-qcom =m; touch must not
#     wait for the root to load the bus driver)
CONFIG_SPI_QCOM_GENI=y
CONFIG_RTC_DRV_PM8XXX=y

# --- VibeOS (as the POCO 7.2.15 kernel)
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
# CONFIG_LOGO is not set
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZ4HC=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_BACKEND_DEFLATE=y
CONFIG_ZRAM_BACKEND_842=y
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_INPUT_UINPUT=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_NETCONSOLE=m
CONFIG_NETCONSOLE_DYNAMIC=y
CONFIG_IPV6=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_RAW=m
CONFIG_IP6_NF_RAW=m
CONFIG_NTSYNC=m
CONFIG_NTFS3_FS=m
CONFIG_USB_UAS=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_BLK_DEV_UBLK=m
CONFIG_INPUT_JOYSTICK=y

# --- VibeOS USB peripherals (HID, Wi-Fi/BT dongles, serial, touch, gamepads; as the POCO)
